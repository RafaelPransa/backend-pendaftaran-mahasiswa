    "/api/admin/keuangan": {
      "get": {
        "tags": ["Admin: Verifikasi Keuangan"],
        "summary": "Mengambil Daftar Ajuan Keuangan / Verifikasi Pembayaran UKT (Admin)",
        "responses": {
          "200": {
            "description": "Berhasil mengambil ajuan keuangan.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Berhasil mengambil ajuan keuangan." },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "keuangan_id": { "type": "string", "format": "uuid" },
                          "user_id": { "type": "string", "format": "uuid" },
                          "nama_lengkap": { "type": "string" },
                          "nik": { "type": "string" },
                          "semester": { "type": "integer" },
                          "tagihan": { "type": "number" },
                          "status_keuangan": { "type": "string" },
                          "tanggal_bayar": { "type": "string", "format": "date-time", "nullable": true },
                          "prodi_nama": { "type": "string", "nullable": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/admin/keuangan/{keuanganId}/verifikasi": {
      "put": {
        "tags": ["Admin: Verifikasi Keuangan"],
        "summary": "Verifikasi Pembayaran UKT Calon Mahasiswa (Admin)",
        "parameters": [
          {
            "name": "keuanganId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["lunas", "belum_bayar"],
                    "example": "lunas"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Berhasil memverifikasi pembayaran UKT."
          },
          "400": {
            "description": "Status verifikasi tidak valid!"
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": {
            "description": "Data tagihan tidak ditemukan!"
          }
        }
      }
    },
    "/api/admin/staff/reset-password": {
      "post": {
        "tags": ["Admin: Keamanan Staff"],
        "summary": "Mereset Password Akun Staff/Admin Lain",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "staff@example.com" },
                  "id": { "type": "string", "format": "uuid", "description": "Dapat dicari via ID jika email kosong" },
                  "password": { "type": "string", "minLength": 6, "example": "passwordbaru123" },
                  "confirmPassword": { "type": "string", "example": "passwordbaru123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password staff berhasil diubah." },
          "404": { "description": "Staff/Admin tidak ditemukan." }
        }
      }
    }
  }
